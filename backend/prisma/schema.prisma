datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                      String            @id @default(cuid())
  email                   String            @unique
  password_hash           String
  name                    String?
  avatar_url              String?
  stripe_customer_id      String?           @unique
  stripe_subscription_id  String?
  subscription_status     String            @default("free")
  subscription_expires_at DateTime?
  password_reset_token    String?
  password_reset_expires  DateTime?
  refresh_tokens          RefreshToken[]
  books                   Book[]
  reading_days            ReadingDay[]
  challenges              Challenge[]
  vision_board_items      VisionBoardItem[]
  favorite_authors        FavoriteAuthor[]
  created_at              DateTime          @default(now())
  updated_at              DateTime          @updatedAt
}

model RefreshToken {
  id         String   @id @default(cuid())
  token      String   @unique
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  expires_at DateTime
  created_at DateTime @default(now())
}

model Book {
  id                 String          @id @default(cuid())
  user_id            String
  user               User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  title              String
  author             String
  genre              String?
  pages              Int?
  format             String?
  cover_url          String?
  status             String          @default("quero_ler")
  progress           Int             @default(0)
  start_date         DateTime?
  end_date           DateTime?
  rating             Int?
  rating_plot        Int?
  rating_characters  Int?
  rating_ending      Int?
  rating_writing     Int?
  emotions           String[]
  review             String?
  would_recommend    Boolean?
  is_favorite        Boolean         @default(false)
  favorite_quote     String?
  series_name        String?
  series_position    Int?
  is_trilogy         Boolean         @default(false)
  wishlist           Boolean         @default(false)
  abandonment_reason String?
  reading_days       ReadingDay[]
  challenge_items    ChallengeItem[]
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt
}

model ReadingDay {
  id        String   @id @default(cuid())
  user_id   String
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  book_id   String
  book      Book     @relation(fields: [book_id], references: [id], onDelete: Cascade)
  read_date DateTime @db.Date

  @@unique([user_id, book_id, read_date])
}

model Challenge {
  id         String          @id @default(cuid())
  user_id    String
  user       User            @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       String
  name       String
  goal       Int?
  year       Int             @default(2025)
  is_active  Boolean         @default(true)
  items      ChallengeItem[]
  created_at DateTime        @default(now())
}

model ChallengeItem {
  id           String    @id @default(cuid())
  challenge_id String
  challenge    Challenge @relation(fields: [challenge_id], references: [id], onDelete: Cascade)
  book_id      String?
  book         Book?     @relation(fields: [book_id], references: [id], onDelete: SetNull)
  slot_label   String?
  position     Int
  completed    Boolean   @default(false)
}

model VisionBoardItem {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type       String
  content    String?
  position_x Int      @default(0)
  position_y Int      @default(0)
  width      Int      @default(200)
  height     Int      @default(150)
  bg_color   String   @default("#FAF7F2")
  created_at DateTime @default(now())
}

model FavoriteAuthor {
  id          String   @id @default(cuid())
  user_id     String
  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  name        String
  nationality String?
  photo_url   String?
  notes       String?
  is_national Boolean  @default(false)
  created_at  DateTime @default(now())
}
